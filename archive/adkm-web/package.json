{
  "name": "adkm-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ADKM · 浏览器界面的本地优先知识库（AsciiDoc + Markdown，Git 版本）",
  "scripts": {
    "start": "node server/index.ts",
    "dev:server": "node --watch server/index.ts",
    "dev:web": "vite",
    "check:styles": "node scripts/check-styles.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run check:styles && npm run typecheck",
    "build:web": "npm run check:styles && vite build",
    "build": "npm run build:web"
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "sass": "^1.108.2",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
