+#[tauri::command]
+fn llm_cancel(state: tauri::State<'_, LlmCancels>, request_id: String) {
+    if let Ok(map) = state.0.lock() {
+        if let Some(flag) = map.get(&request_id) {
+            flag.store(true, Ordering::Relaxed);
+        }
+    }
+}
