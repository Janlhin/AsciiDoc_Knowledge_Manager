diff --git a/src/core/llm/client.ts b/src/core/llm/client.ts
new file mode 100644
index 0000000..c579581
--- /dev/null
+++ b/src/core/llm/client.ts
@@ -0,0 +1,232 @@
+/**
+ * OpenAI-compatible chat client with streaming.
+ *
+ * Two transports behind one API:
+ *  - Desktop (Tauri): Rust `llm_stream` reads SSE off the UI thread and pushes
+ *    `llm:chunk` / `llm:done` / `llm:error` events. No CORS, no 30s cap.
+ *  - Browser dev: fetch + ReadableStream, CORS-bound (dev convenience only).
+ *
+ * The provider-specific JSON parsing lives here (not in Rust) so adding a
+ * protocol later does not touch the transport layer.
+ */
+import { base64ToBytes, httpRequest } from "../net";
+import { isTauri } from "../vault";
+import { extractOpenAiDelta, extractProviderError } from "./sse";
+import { secretGet } from "./secrets";
+import type { ChatMessage, LlmProvider } from "./types";
+
+export interface StreamChatOptions {
+  provider: LlmProvider;
+  messages: ChatMessage[];
+  onDelta: (delta: string) => void;
+  signal?: AbortSignal;
+}
+
+/** Append `/chat/completions` unless the user already pasted a full endpoint. */
+export function chatCompletionsUrl(baseUrl: string): string {
+  const trimmed = baseUrl.trim().replace(/\/+$/, "");
+  if (trimmed === "") throw new Error("Base URL 为空");
+  if (/\/chat\/completions$/i.test(trimmed)) return trimmed;
+  return `${trimmed}/chat/completions`;
+}
+
+async function buildRequest(
+  provider: LlmProvider,
+  messages: ChatMessage[],
+  stream: boolean,
+): Promise<{ url: string; headers: Record<string, string>; body: string }> {
+  const url = chatCompletionsUrl(provider.baseUrl);
+  const key = provider.secretName === "" ? null : await secretGet(provider.secretName);
+  const headers: Record<string, string> = {
+    "Content-Type": "application/json",
+    Accept: stream ? "text/event-stream" : "application/json",
+  };
+  if (key !== null && key !== "") headers.Authorization = `Bearer ${key}`;
+  const payload: Record<string, unknown> = {
+    model: provider.model,
+    messages,
+    stream,
+  };
+  if (provider.temperature > 0) payload.temperature = provider.temperature;
+  if (provider.maxTokens !== undefined && provider.maxTokens > 0) {
+    payload.max_tokens = provider.maxTokens;
+  }
+  return { url, headers, body: JSON.stringify(payload) };
+}
+
+export async function streamChat(options: StreamChatOptions): Promise<void> {
+  const { provider, messages, onDelta, signal } = options;
+  if (provider.model.trim() === "") throw new Error("未配置模型名称");
+  if (signal?.aborted === true) return;
+  const request = await buildRequest(provider, messages, true);
+  if (isTauri()) {
+    await streamViaTauri(request, onDelta, signal);
+    return;
+  }
+  await streamViaFetch(request, onDelta, signal);
+}
+
+interface StreamRequest {
+  url: string;
+  headers: Record<string, string>;
+  body: string;
+}
+
+function newRequestId(): string {
+  const uuid = globalThis.crypto?.randomUUID?.();
+  if (typeof uuid === "string") return uuid;
+  return `llm-${Date.now()}-${Math.random().toString(36).slice(2, 10)}`;
+}
+
+async function streamViaTauri(
+  request: StreamRequest,
+  onDelta: (delta: string) => void,
+  signal: AbortSignal | undefined,
+): Promise<void> {
+  const [{ invoke }, { listen }] = await Promise.all([
+    import("@tauri-apps/api/core"),
+    import("@tauri-apps/api/event"),
+  ]);
+  const requestId = newRequestId();
+  let settled = false;
+  let resolveDone: () => void = () => {};
+  let rejectDone: (error: Error) => void = () => {};
+  const finished = new Promise<void>((resolve, reject) => {
+    resolveDone = resolve;
+    rejectDone = reject;
+  });
+  const settle = (action: () => void) => {
+    if (settled) return;
+    settled = true;
+    action();
+  };
+
+  const unlisteners: Array<() => void> = [];
+  unlisteners.push(
+    await listen<{ requestId: string; data: string }>("llm:chunk", (event) => {
+      if (event.payload.requestId !== requestId) return;
+      const delta = extractOpenAiDelta(event.payload.data);
+      if (delta !== null) onDelta(delta);
+    }),
+  );
+  unlisteners.push(
+    await listen<{ requestId: string }>("llm:done", (event) => {
+      if (event.payload.requestId !== requestId) return;
+      settle(resolveDone);
+    }),
+  );
+  unlisteners.push(
+    await listen<{ requestId: string; message: string }>("llm:error", (event) => {
+      if (event.payload.requestId !== requestId) return;
+      const message = event.payload.message;
+      settle(() => rejectDone(new Error(message)));
+    }),
+  );
+
+  const cleanup = () => {
+    for (const unlisten of unlisteners) unlisten();
+  };
+  const onAbort = () => {
+    void invoke("llm_cancel", { requestId }).catch(() => {});
+    settle(resolveDone);
+  };
+  signal?.addEventListener("abort", onAbort, { once: true });
+
+  try {
+    await invoke("llm_stream", {
+      req: {
+        requestId,
+        url: request.url,
+        headers: request.headers,
+        bodyText: request.body,
+      },
+    });
+    await finished;
+  } finally {
+    signal?.removeEventListener("abort", onAbort);
+    cleanup();
+  }
+}
+
+async function streamViaFetch(
+  request: StreamRequest,
+  onDelta: (delta: string) => void,
+  signal: AbortSignal | undefined,
+): Promise<void> {
+  const response = await fetch(request.url, {
+    method: "POST",
+    headers: request.headers,
+    body: request.body,
+    signal,
+  });
+  if (!response.ok) {
+    const text = await response.text();
+    throw new Error(`HTTP ${response.status}: ${extractProviderError(text) ?? ""}`);
+  }
+  if (response.body === null) throw new Error("当前环境不支持流式响应");
+  const reader = response.body.getReader();
+  const decoder = new TextDecoder();
+  let buffer = "";
+  for (;;) {
+    const { value, done } = await reader.read();
+    if (done) break;
+    buffer += decoder.decode(value, { stream: true });
+    for (;;) {
+      const newline = buffer.indexOf("\n");
+      if (newline < 0) break;
+      const line = buffer.slice(0, newline).replace(/\r$/, "");
+      buffer = buffer.slice(newline + 1);
+      if (!line.startsWith("data:")) continue;
+      const data = line.slice("data:".length).trim();
+      if (data === "[DONE]") return;
+      const delta = extractOpenAiDelta(data);
+      if (delta !== null) onDelta(delta);
+    }
+  }
+}
+
+export interface TestResult {
+  /** Whatever text the model returned; "OK" when empty. */
+  reply: string;
+}
+
+/**
+ * Non-streaming round-trip used by Settings → AI → 测试连接. Reuses the
+ * existing CORS-free `http_request` transport (30s, 10 MB) — a connection test
+ * has no reason to stream, and this keeps the failure surface small.
+ */
+export async function testProvider(provider: LlmProvider): Promise<TestResult> {
+  if (provider.model.trim() === "") throw new Error("未配置模型名称");
+  const request = await buildRequest(
+    provider,
+    [{ role: "user", content: "Reply with the single word: OK" }],
+    false,
+  );
+  const response = await httpRequest({
+    url: request.url,
+    method: "POST",
+    headers: request.headers,
+    contentType: "application/json",
+    bodyText: request.body,
+  });
+  const text = new TextDecoder().decode(base64ToBytes(response.bodyBase64));
+  if (response.status < 200 || response.status >= 300) {
+    throw new Error(`HTTP ${response.status}: ${extractProviderError(text) ?? text.slice(0, 300)}`);
+  }
+  try {
+    const parsed: unknown = JSON.parse(text);
+    if (typeof parsed === "object" && parsed !== null) {
+      const choices = (parsed as { choices?: unknown }).choices;
+      if (Array.isArray(choices) && choices.length > 0) {
+        const message = (choices[0] as { message?: { content?: unknown } }).message;
+        const content = message?.content;
+        if (typeof content === "string" && content.trim() !== "") {
+          return { reply: content.trim().slice(0, 200) };
+        }
+      }
+    }
+  } catch {
+    /* fall through */
+  }
+  return { reply: "OK" };
+}
diff --git a/src/core/llm/secrets.ts b/src/core/llm/secrets.ts
new file mode 100644
index 0000000..ec50b2a
--- /dev/null
+++ b/src/core/llm/secrets.ts
@@ -0,0 +1,93 @@
+/**
+ * API-key storage. Desktop: OS credential store via the Rust `secret_*`
+ * commands (Windows Credential Manager / macOS Keychain). Browser dev server:
+ * localStorage, clearly a degraded fallback — never used in a packaged build.
+ *
+ * The credential store cannot be enumerated portably, so the *names* of the
+ * secrets we created are indexed locally. Values are never indexed.
+ */
+import { isTauri } from "../vault";
+
+const BROWSER_PREFIX = "adkm.llm.secret.";
+const INDEX_KEY = "adkm.llm.secretIndex";
+
+function readIndex(): string[] {
+  try {
+    const raw = localStorage.getItem(INDEX_KEY);
+    if (!raw) return [];
+    const parsed: unknown = JSON.parse(raw);
+    if (!Array.isArray(parsed)) return [];
+    return parsed.filter((v): v is string => typeof v === "string");
+  } catch {
+    return [];
+  }
+}
+
+function writeIndex(names: string[]): void {
+  try {
+    localStorage.setItem(INDEX_KEY, JSON.stringify(names));
+  } catch {
+    /* ignore */
+  }
+}
+
+/** Names of secrets this app has stored (for Settings → Keychain). */
+export function listSecretNames(): string[] {
+  return readIndex();
+}
+
+function rememberName(name: string): void {
+  const names = readIndex();
+  if (!names.includes(name)) writeIndex([...names, name].sort());
+}
+
+function forgetName(name: string): void {
+  writeIndex(readIndex().filter((n) => n !== name));
+}
+
+/** True when keys are persisted in the OS credential store (desktop only). */
+export function usesOsCredentialStore(): boolean {
+  return isTauri();
+}
+
+export async function secretSet(name: string, value: string): Promise<void> {
+  if (isTauri()) {
+    const { invoke } = await import("@tauri-apps/api/core");
+    await invoke("secret_set", { name, value });
+    rememberName(name);
+    return;
+  }
+  localStorage.setItem(BROWSER_PREFIX + name, value);
+  rememberName(name);
+}
+
+/** Returns null when no value is stored (not an error). */
+export async function secretGet(name: string): Promise<string | null> {
+  if (name === "") return null;
+  if (isTauri()) {
+    const { invoke } = await import("@tauri-apps/api/core");
+    return invoke<string | null>("secret_get", { name });
+  }
+  return localStorage.getItem(BROWSER_PREFIX + name);
+}
+
+export async function secretDelete(name: string): Promise<void> {
+  if (isTauri()) {
+    const { invoke } = await import("@tauri-apps/api/core");
+    await invoke("secret_delete", { name });
+    forgetName(name);
+    return;
+  }
+  localStorage.removeItem(BROWSER_PREFIX + name);
+  forgetName(name);
+}
+
+/** Whether a value exists for `name` (does not return the value itself). */
+export async function secretExists(name: string): Promise<boolean> {
+  if (name === "") return false;
+  try {
+    return (await secretGet(name)) !== null;
+  } catch {
+    return false;
+  }
+}
diff --git a/src/core/llm/sse.ts b/src/core/llm/sse.ts
new file mode 100644
index 0000000..c3d07c1
--- /dev/null
+++ b/src/core/llm/sse.ts
@@ -0,0 +1,120 @@
+/**
+ * Pure helpers for the OpenAI-compatible SSE stream and for safe message
+ * rendering. No DOM, no Tauri, no network — unit-testable in Node.
+ */
+
+/**
+ * Incremental text carried by one `data:` frame.
+ * Returns null for frames that carry no text (role-only deltas, usage tails,
+ * keep-alives, malformed JSON).
+ *
+ * Shape handled: `{ choices: [{ delta: { content } }] }` where `content` is
+ * either a string or an array of `{ type: "text", text }` parts (some
+ * gateways normalise to the array form).
+ */
+export function extractOpenAiDelta(data: string): string | null {
+  if (data === "" || data === "[DONE]") return null;
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(data);
+  } catch {
+    return null;
+  }
+  if (typeof parsed !== "object" || parsed === null) return null;
+  const choices = (parsed as { choices?: unknown }).choices;
+  if (!Array.isArray(choices) || choices.length === 0) return null;
+  const first = choices[0] as { delta?: unknown; text?: unknown };
+  // Legacy /completions frames put text at choices[0].text.
+  if (typeof first.text === "string") return first.text;
+  const delta = first.delta;
+  if (typeof delta !== "object" || delta === null) return null;
+  const content = (delta as { content?: unknown }).content;
+  if (typeof content === "string") return content === "" ? null : content;
+  if (Array.isArray(content)) {
+    let out = "";
+    for (const part of content) {
+      if (typeof part === "object" && part !== null) {
+        const text = (part as { text?: unknown }).text;
+        if (typeof text === "string") out += text;
+      }
+    }
+    return out === "" ? null : out;
+  }
+  return null;
+}
+
+/** Human-readable message from a provider error body, if one is present. */
+export function extractProviderError(body: string): string | null {
+  const trimmed = body.trim();
+  if (trimmed === "") return null;
+  try {
+    const parsed: unknown = JSON.parse(trimmed);
+    if (typeof parsed === "object" && parsed !== null) {
+      const error = (parsed as { error?: unknown }).error;
+      if (typeof error === "string") return error;
+      if (typeof error === "object" && error !== null) {
+        const message = (error as { message?: unknown }).message;
+        if (typeof message === "string") return message;
+      }
+      const message = (parsed as { message?: unknown }).message;
+      if (typeof message === "string") return message;
+    }
+  } catch {
+    /* not JSON — fall through to the raw text */
+  }
+  return trimmed.length > 500 ? `${trimmed.slice(0, 500)}…` : trimmed;
+}
+
+export interface TextSegment {
+  kind: "text" | "code";
+  content: string;
+  /** Fence info string (e.g. "ts"), empty for text segments. */
+  lang: string;
+}
+
+/**
+ * Split model output into text and fenced-code segments so the UI can render
+ * code in a <pre> without ever injecting HTML. Deliberately tiny: ``` fences
+ * only (tilde fences and nested fences degrade to text, which is safe).
+ */
+export function splitCodeFences(text: string): TextSegment[] {
+  const lines = text.split("\n");
+  const out: TextSegment[] = [];
+  let buffer: string[] = [];
+  let inCode = false;
+  let lang = "";
+
+  const flushText = () => {
+    if (buffer.length === 0) return;
+    const content = buffer.join("\n");
+    buffer = [];
+    if (content.trim() !== "") out.push({ kind: "text", content, lang: "" });
+  };
+
+  for (const line of lines) {
+    const fence = /^\s*```(.*)$/.exec(line);
+    if (fence !== null) {
+      if (!inCode) {
+        flushText();
+        inCode = true;
+        lang = fence[1].trim();
+      } else {
+        out.push({ kind: "code", content: buffer.join("\n"), lang });
+        buffer = [];
+        inCode = false;
+        lang = "";
+      }
+      continue;
+    }
+    buffer.push(line);
+  }
+  if (inCode) out.push({ kind: "code", content: buffer.join("\n"), lang });
+  else flushText();
+  return out;
+}
+
+/** Truncate note context by characters, preserving the head (most relevant). */
+export function capContext(text: string, maxChars: number): { text: string; truncated: boolean } {
+  if (text.length <= maxChars) return { text, truncated: false };
+  return { text: text.slice(0, maxChars), truncated: true };
+}
diff --git a/src/core/llm/store.ts b/src/core/llm/store.ts
new file mode 100644
index 0000000..6683c13
--- /dev/null
+++ b/src/core/llm/store.ts
@@ -0,0 +1,98 @@
+/**
+ * Persisted LLM provider list + active selection.
+ *
+ * Persistence is localStorage on purpose: this is *configuration* (URLs, model
+ * names, temperatures). API keys are never written here — they go to the OS
+ * credential store via ./secrets.ts and are referenced by `secretName`.
+ * Mirrors the existing settings pattern (`core/appearance.ts`: Store + readX /
+ * persistX helpers) so every consumer subscribes the same way.
+ */
+import { Store } from "../store";
+import { isLlmProvider, type LlmProvider } from "./types";
+
+const PROVIDERS_KEY = "adkm.llm.providers";
+const ACTIVE_KEY = "adkm.llm.active";
+
+function readProviders(): LlmProvider[] {
+  try {
+    const raw = localStorage.getItem(PROVIDERS_KEY);
+    if (!raw) return [];
+    const parsed: unknown = JSON.parse(raw);
+    if (!Array.isArray(parsed)) return [];
+    return parsed.filter(isLlmProvider);
+  } catch {
+    return [];
+  }
+}
+
+function readActiveId(): string {
+  try {
+    return localStorage.getItem(ACTIVE_KEY) ?? "";
+  } catch {
+    return "";
+  }
+}
+
+export const llmProviders = new Store<LlmProvider[]>(readProviders());
+export const activeLlmProviderId = new Store<string>(readActiveId());
+
+function persistProviders(next: LlmProvider[]): void {
+  llmProviders.set(next);
+  try {
+    localStorage.setItem(PROVIDERS_KEY, JSON.stringify(next));
+  } catch {
+    /* quota / private mode — the in-memory store still works this session */
+  }
+}
+
+function persistActive(id: string): void {
+  activeLlmProviderId.set(id);
+  try {
+    localStorage.setItem(ACTIVE_KEY, id);
+  } catch {
+    /* ignore */
+  }
+}
+
+/** New id that never collides with an existing provider. */
+export function uniqueProviderId(base: string, existing: ReadonlyArray<LlmProvider>): string {
+  const taken = new Set(existing.map((p) => p.id));
+  if (!taken.has(base)) return base;
+  for (let i = 2; ; i++) {
+    const candidate = `${base}-${i}`;
+    if (!taken.has(candidate)) return candidate;
+  }
+}
+
+export function addProvider(provider: LlmProvider): void {
+  const next = [...llmProviders.get(), provider];
+  persistProviders(next);
+  if (!activeLlmProviderId.get()) persistActive(provider.id);
+}
+
+export function updateProvider(provider: LlmProvider): void {
+  persistProviders(llmProviders.get().map((p) => (p.id === provider.id ? provider : p)));
+}
+
+export function removeProvider(id: string): void {
+  const next = llmProviders.get().filter((p) => p.id !== id);
+  persistProviders(next);
+  if (activeLlmProviderId.get() === id) persistActive(next[0]?.id ?? "");
+}
+
+export function setActiveLlmProvider(id: string): void {
+  persistActive(id);
+}
+
+/** The provider the panel should use right now (active, else first). */
+export function resolveActiveProvider(
+  providers: ReadonlyArray<LlmProvider>,
+  activeId: string,
+): LlmProvider | null {
+  return providers.find((p) => p.id === activeId) ?? providers[0] ?? null;
+}
+
+/** True when the provider is configured enough to send a request. */
+export function isProviderUsable(provider: LlmProvider): boolean {
+  return provider.baseUrl.trim() !== "" && provider.model.trim() !== "";
+}
diff --git a/src/core/llm/types.ts b/src/core/llm/types.ts
