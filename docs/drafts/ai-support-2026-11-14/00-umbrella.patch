+
+/// Delete a secret. Missing entries are a no-op (idempotent).
+#[tauri::command(async)]
+fn secret_delete(name: String) -> CmdResult<()> {
+    let entry =
+        keyring::Entry::new(SECRET_SERVICE, &name).map_err(|e| format!("secret_delete: {e}"))?;
