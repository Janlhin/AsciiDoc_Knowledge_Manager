    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "sass": "^1.108.2",
    "typescript": "^7.0.2",
    "vite": "^6.0.0"
  }
