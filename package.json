{
  "name": "geode",
  "private": true,
  "version": "0.269.0",
  "description": "Geode — a local-first markdown knowledge base (Obsidian-style), built with Tauri 2 + React + CodeMirror 6",
  "license": "Apache-2.0",
  "author": "AlexHercules",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexHercules/geode.git"
  },
  "bugs": {
    "url": "https://github.com/AlexHercules/geode/issues"
  },
  "homepage": "https://github.com/AlexHercules/geode#readme",
  "keywords": [
    "markdown",
    "markdown-editor",
    "notes",
    "note-taking",
    "knowledge-base",
    "obsidian",
    "obsidian-like",
    "obsidian-alternative",
    "pkm",
    "personal-knowledge-management",
    "tauri",
    "codemirror",
    "local-first"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc --noEmit && vp build",
    "preview": "vp preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run typecheck:scripts && npm run build",
    "profile:hotspots": "node scripts/profile-hotspots.ts",
    "profile:bigfile": "node scripts/profile-bigfile.ts",
    "verify:block-scan": "node scripts/verify-block-scan.ts",
    "report:index": "node scripts/adoc-index-report.ts",
    "verify:llm-sse": "node scripts/verify-llm-sse.ts",
    "verify:readable-width": "node scripts/verify-readable-width.ts",
    "verify:workspace-keys": "node scripts/verify-workspace-keys.ts"
  },
  "dependencies": {
    "@asciidoctor/core": "^4.2.1",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@replit/codemirror-vim": "^6.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "d3-force": "^3.0.0",
    "epubjs": "^0.3.93",
    "js-yaml": "^4.3.0",
    "jszip": "^3.10.2",
    "katex": "^0.17.0",
    "mammoth": "^1.13.0",
    "markdown-it": "^14.1.0",
    "mermaid": "^11.15.0",
    "moment": "^2.30.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "x-data-spreadsheet": "^1.1.9",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/d3-force": "^3.0.10",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "less": "^4.9.1",
    "sass": "^1.108.2",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vite-plus": "1.6.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0"
  }
}
